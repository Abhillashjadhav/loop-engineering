{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://loop-engineering/schemas/portfolio-auditor-contract.schema.json",
  "title": "Portfolio Auditor Product Decision Contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_id",
    "version",
    "title",
    "north_star",
    "primary_users",
    "scope",
    "product_decisions",
    "assessment_dimensions",
    "recommendation_verdicts",
    "ai_slop_policy",
    "business_accuracy",
    "evidence_model",
    "scoring_model",
    "prioritization",
    "remediation_policy",
    "audit_modes",
    "safety_privacy",
    "metrics",
    "integration_boundary",
    "provenance_fields",
    "amendments"
  ],
  "properties": {
    "contract_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string" },
    "north_star": { "type": "string", "minLength": 1 },
    "primary_users": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "out_of_scope": { "type": "array", "items": { "type": "string" } },
    "product_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "decision"],
        "properties": {
          "id": { "type": "string" },
          "decision": { "type": "string" }
        }
      }
    },
    "assessment_dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key"],
        "properties": { "key": { "type": "string" } }
      }
    },
    "recommendation_verdicts": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 5,
      "maxItems": 5
    },
    "ai_slop_policy": {
      "type": "object",
      "required": [
        "verdicts",
        "hard_verdict_min_confidence",
        "require_counter_evidence_review",
        "default_when_uncertain",
        "forbidden_sole_bases"
      ],
      "properties": {
        "verdicts": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 },
        "hard_verdict_min_confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "require_counter_evidence_review": { "type": "boolean" },
        "default_when_uncertain": { "type": "string" },
        "forbidden_sole_bases": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "business_accuracy": {
      "type": "object",
      "required": ["scale", "absence_is_not_falsehood"],
      "properties": {
        "scale": { "type": "array", "items": { "type": "string" }, "minItems": 5, "maxItems": 5 },
        "absence_is_not_falsehood": { "type": "boolean" }
      }
    },
    "evidence_model": {
      "type": "object",
      "required": ["finding_required_fields", "valid_evidence_kinds", "independence_key"],
      "properties": {
        "finding_required_fields": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "valid_evidence_kinds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "independence_key": { "type": "string" },
        "corroboration_min_origins_normal": { "type": "integer", "minimum": 1 },
        "corroboration_min_origins_high_impact": { "type": "integer", "minimum": 1 }
      }
    },
    "scoring_model": {
      "type": "object",
      "required": [
        "confidence_range",
        "high_confidence_floor",
        "numeric_score_never_overrides_material_finding"
      ],
      "properties": {
        "confidence_range": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "high_confidence_floor": { "type": "integer", "minimum": 0, "maximum": 100 },
        "numeric_score_never_overrides_material_finding": { "type": "boolean" },
        "dimension_scale": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 }
      }
    },
    "prioritization": {
      "type": "object",
      "required": ["formula", "priority_order"],
      "properties": {
        "formula": { "type": "string" },
        "priority_order": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "numeric_score_never_overrides_material_high_confidence_finding": { "type": "boolean" }
      }
    },
    "remediation_policy": {
      "type": "object",
      "required": [
        "auto_merge_scope",
        "never_auto_merges_the_auditor_feature_branch",
        "auto_merge_required_gates",
        "forbidden_auto_merge_actions"
      ],
      "properties": {
        "auto_merge_scope": { "type": "string" },
        "never_auto_merges_the_auditor_feature_branch": { "type": "boolean" },
        "auto_merge_required_gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": { "id": { "type": "string" } }
          }
        },
        "forbidden_auto_merge_actions": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "audit_modes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "safety_privacy": {
      "type": "object",
      "required": [
        "redact_private_origins_in_public_reports",
        "least_privilege_github_permissions",
        "dry_run_default",
        "explicit_repository_allowlist_required",
        "block_destructive_actions"
      ]
    },
    "metrics": {
      "type": "object",
      "required": ["north_star", "leading", "quality_guardrail"],
      "properties": {
        "north_star": { "type": "string" },
        "leading": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "quality_guardrail": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "integration_boundary": {
      "type": "object",
      "required": ["module_root", "config_root", "fixtures_root", "reuses"],
      "properties": {
        "module_root": { "type": "string" },
        "config_root": { "type": "string" },
        "fixtures_root": { "type": "string" },
        "reuses": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "adds_no_imports_into_existing_modules": { "type": "boolean" }
      }
    },
    "provenance_fields": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["amended_at", "approved_by", "reason", "previous_digest"]
      }
    },
    "canonical_digest": { "type": "string" }
  }
}
