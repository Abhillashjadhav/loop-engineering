[{"sha":"fae8ec8c52ab02bdca339e2dc09364482a97afbb","node_id":"C_kwDOSzU6R9oAKGZhZThlYzhjNTJhYjAyYmRjYTMzOWUyZGMwOTM2NDQ4MmE5N2FmYmI","commit":{"author":{"name":"Pawel Huryn","email":"pawel.huryn@gmail.com","date":"2026-06-06T21:12:13Z"},"committer":{"name":"Pawel Huryn","email":"pawel.huryn@gmail.com","date":"2026-06-06T21:12:13Z"},"message":"Build stage uses frontend-design; stop committing generated results\n\n- Build agents now explicitly invoke the frontend-design skill for distinctive,\n  production-grade prototypes, instead of relying on the skill's auto-trigger.\n- gitignore outputs/* (keep .gitkeep): this repo is \"generate your own,\" so\n  rankings and HTML prototypes are no longer committed. Removed the sample\n  prototypes + smoke-10.md and the doc references to them.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","tree":{"sha":"9761146d57f55a23a09f018b0aa279c9c34c2ef5","url":"https://api.github.com/repos/phuryn/dynamic-workflows-experiment/git/trees/9761146d57f55a23a09f018b0aa279c9c34c2ef5"},"url":"https://api.github.com/repos/phuryn/dynamic-workflows-experiment/git/commits/fae8ec8c52ab02bdca339e2dc09364482a97afbb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/phuryn/dynamic-workflows-experiment/commits/fae8ec8c52ab02bdca339e2dc09364482a97afbb","html_url":"https://github.com/phuryn/dynamic-workflows-experiment/commit/fae8ec8c52ab02bdca339e2dc09364482a97afbb","comments_url":"https://api.github.com/repos/phuryn/dynamic-workflows-experiment/commits/fae8ec8c52ab02bdca339e2dc09364482a97afbb/comments","author":{"login":"phuryn","id":7837354,"node_id":"MDQ6VXNlcjc4MzczNTQ=","avatar_url":"https://avatars.githubusercontent.com/u/7837354?v=4","gravatar_id":"","url":"https://api.github.com/users/phuryn","html_url":"https://github.com/phuryn","followers_url":"https://api.github.com/users/phuryn/followers","following_url":"https://api.github.com/users/phuryn/following{/other_user}","gists_url":"https://api.github.com/users/phuryn/gists{/gist_id}","starred_url":"https://api.github.com/users/phuryn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/phuryn/subscriptions","organizations_url":"https://api.github.com/users/phuryn/orgs","repos_url":"https://api.github.com/users/phuryn/repos","events_url":"https://api.github.com/users/phuryn/events{/privacy}","received_events_url":"https://api.github.com/users/phuryn/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"phuryn","id":7837354,"node_id":"MDQ6VXNlcjc4MzczNTQ=","avatar_url":"https://avatars.githubusercontent.com/u/7837354?v=4","gravatar_id":"","url":"https://api.github.com/users/phuryn","html_url":"https://github.com/phuryn","followers_url":"https://api.github.com/users/phuryn/followers","following_url":"https://api.github.com/users/phuryn/following{/other_user}","gists_url":"https://api.github.com/users/phuryn/gists{/gist_id}","starred_url":"https://api.github.com/users/phuryn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/phuryn/subscriptions","organizations_url":"https://api.github.com/users/phuryn/orgs","repos_url":"https://api.github.com/users/phuryn/repos","events_url":"https://api.github.com/users/phuryn/events{/privacy}","received_events_url":"https://api.github.com/users/phuryn/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0d945a3a6852eb1e9ee466a114767b91337cea12","url":"https://api.github.com/repos/phuryn/dynamic-workflows-experiment/commits/0d945a3a6852eb1e9ee466a114767b91337cea12","html_url":"https://github.com/phuryn/dynamic-workflows-experiment/commit/0d945a3a6852eb1e9ee466a114767b91337cea12"}]},{"sha":"0d945a3a6852eb1e9ee466a114767b91337cea12","node_id":"C_kwDOSzU6R9oAKDBkOTQ1YTNhNjg1MmViMWU5ZWU0NjZhMTE0NzY3YjkxMzM3Y2VhMTI","commit":{"author":{"name":"Pawel Huryn","email":"pawel.huryn@gmail.com","date":"2026-06-06T19:35:31Z"},"committer":{"name":"Pawel Huryn","email":"pawel.huryn@gmail.com","date":"2026-06-06T19:35:31Z"},"message":"Initial commit: dynamic-workflows discovery experiment\n\nThe experiment behind the Product Compass article \"Dynamic Workflows:\nThe Orchestrator Moved Off the Model.\" A product-discovery loop that runs\nblind against 100 synthetic interviews and recovers a planted answer key:\nextract (Haiku) -> canonicalize -> score (code) -> ideate + triage\n(Sonnet) -> build HTML prototypes -> loop.\n\n- interviews/: 100 synthetic transcripts (Haiku-generated, blind input)\n- ground-truth/: product, strategy, hidden answer key (never fed to the analysis)\n- prompts/: generate the interviews + run the analysis (you write the harness from the prompt)\n- example-workflows/: reference harnesses (read, don't invoke)\n- outputs/: 10-interview smoke calibration + sample HTML prototypes\n\nThe Canonicalize stage exists because exact-slug dedupe fragmented one\nneed across ~50 slugs; clustering to canonical needs before scoring is\nwhat makes recovery clean. See outputs/smoke-10.md.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","tree":{"sha":"516135e3aed549ad776ac7924c495df6b8b76157","url":"https://api.github.com/repos/phuryn/dynamic-workflows-experiment/git/trees/516135e3aed549ad776ac7924c495df6b8b76157"},"url":"https://api.github.com/repos/phuryn/dynamic-workflows-experiment/git/commits/0d945a3a6852eb1e9ee466a114767b91337cea12","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/phuryn/dynamic-workflows-experiment/commits/0d945a3a6852eb1e9ee466a114767b91337cea12","html_url":"https://github.com/phuryn/dynamic-workflows-experiment/commit/0d945a3a6852eb1e9ee466a114767b91337cea12","comments_url":"https://api.github.com/repos/phuryn/dynamic-workflows-experiment/commits/0d945a3a6852eb1e9ee466a114767b913