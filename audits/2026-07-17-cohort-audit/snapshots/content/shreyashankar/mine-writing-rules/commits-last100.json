bc4de0","html_url":"https://github.com/shreyashankar/mine-writing-rules/commit/c574d92a031f33a20e48e9aa648db28c92bc4de0"}]},{"sha":"c574d92a031f33a20e48e9aa648db28c92bc4de0","node_id":"C_kwDOS8q7HtoAKGM1NzRkOTJhMDMxZjMzYTIwZTQ4ZTlhYTY0OGRiMjhjOTJiYzRkZTA","commit":{"author":{"name":"Shreya Shankar","email":"shreyashankar@shreya-mm.local","date":"2026-06-17T00:57:13Z"},"committer":{"name":"Shreya Shankar","email":"shreyashankar@shreya-mm.local","date":"2026-06-17T00:57:13Z"},"message":"Write corrected counts back into writing-rules.json metadata\n\nbuild.js recomputed counts only for the derived files, so the source file's own\nmetadata could drift, e.g., it said 814 rules while holding 836. Now build.js\nwrites the rule, group, and category counts back into writing-rules.json.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","tree":{"sha":"d18affa4b50e7fde21169c25830697652874b8fd","url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/git/trees/d18affa4b50e7fde21169c25830697652874b8fd"},"url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/git/commits/c574d92a031f33a20e48e9aa648db28c92bc4de0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/c574d92a031f33a20e48e9aa648db28c92bc4de0","html_url":"https://github.com/shreyashankar/mine-writing-rules/commit/c574d92a031f33a20e48e9aa648db28c92bc4de0","comments_url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/c574d92a031f33a20e48e9aa648db28c92bc4de0/comments","author":null,"committer":null,"parents":[{"sha":"fb8caf0931a0f86081fea6a412154998796400a5","url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/fb8caf0931a0f86081fea6a412154998796400a5","html_url":"https://github.com/shreyashankar/mine-writing-rules/commit/fb8caf0931a0f86081fea6a412154998796400a5"}]},{"sha":"fb8caf0931a0f86081fea6a412154998796400a5","node_id":"C_kwDOS8q7HtoAKGZiOGNhZjA5MzFhMGY4NjA4MWZlYTZhNDEyMTU0OTk4Nzk2NDAwYTU","commit":{"author":{"name":"Shreya Shankar","email":"shreyashankar@shreya-mm.local","date":"2026-06-17T00:56:37Z"},"committer":{"name":"Shreya Shankar","email":"shreyashankar@shreya-mm.local","date":"2026-06-17T00:56:37Z"},"message":"Add 22 rules from 4 web sources; bias discovery away from journalism\n\nFirst automated discovery run added the BBC News Styleguide, Duke Scientific\nWriting Resource, MIT Mayfield Handbook, and Plain English Campaign. It added 22\nnew rules (R815-R836) and merged 79 mined rules into existing rules. Corpus is\nnow 836 rules from 67 sources.\n\nUpdate the discovery prompt to prefer technical, academic, and nonfiction guides\nand avoid news and journalism guides, since news is not a target genre.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","tree":{"sha":"7b3ed519e069cfe2b6cf8404b9ea136bb7b3ed5a","url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/git/trees/7b3ed519e069cfe2b6cf8404b9ea136bb7b3ed5a"},"url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/git/commits/fb8caf0931a0f86081fea6a412154998796400a5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/fb8caf0931a0f86081fea6a412154998796400a5","html_url":"https://github.com/shreyashankar/mine-writing-rules/commit/fb8caf0931a0f86081fea6a412154998796400a5","comments_url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/fb8caf0931a0f86081fea6a412154998796400a5/comments","author":null,"committer":null,"parents":[{"sha":"56b901275600d946299e736831104cf4df7ed8aa","url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/56b901275600d946299e736831104cf4df7ed8aa","html_url":"https://github.com/shreyashankar/mine-writing-rules/commit/56b901275600d946299e736831104cf4df7ed8aa"}]},{"sha":"56b901275600d946299e736831104cf4df7ed8aa","node_id":"C_kwDOS8q7HtoAKDU2YjkwMTI3NTYwMGQ5NDYyOTllNzM2ODMxMTA0Y2Y0ZGY3ZWQ4YWE","commit":{"author":{"name":"Shreya Shankar","email":"shreyashankar@shreya-mm.local","date":"2026-06-16T21:49:47Z"},"committer":{"name":"Shreya Shankar","email":"shreyashankar@shreya-mm.local","date":"2026-06-16T21:49:47Z"},"message":"Rewrite all 814 rules in plain style\n\nRewrote each rule's rule text, rationale, and fixed example to follow the\nplain-writing skill: simple words, complete sentences, no em or en dashes,\nranges written with \"to\", colons only for lists, no jargon, imagery, or filler.\nLeft every example_violation unchanged so it still breaks its rule, and kept the\npunctuation marks in fixed examples for rules that are about those marks.\n\nAdd .claude/workflows/plain-style-rules.js, the shard-and-verify workflow that\nproduced this, and make the add-writing-rules miner write new rules in plain\nstyle too. Rebuilt writing-rules.flat.json and dashboard.html.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","tree":{"sha":"898d4d20262e997cec6888b5afb2f58b8eada227","url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/git/trees/898d4d20262e997cec6888b5afb2f58b8eada227"},"url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/git/commits/56b901275600d946299e736831104cf4df7ed8aa","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/56b901275600d946299e736831104cf4df7ed8aa","html_url":"https://github.com/shreyashankar/mine-writing-rules/commit/56b901275600d946299e736831104cf4df7ed8aa","comments_url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/56b901275600d946299e736831104cf4df7ed8aa/comments","author":null,"committer":null,"parents":[{"sha":"01aeb8e2449a8f425490b5d449dc9f9d9e08f6d4","url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/01aeb8e2449a8f425490b5d449dc9f9d9e08f6d4","html_url":"https://github.com/shreyashankar/mine-writing-rules/commit/01aeb8e2449a8f425490b5d449dc9f9d9e08f6d4"}]},{"sha":"01aeb8e2449a8f425490b5d449dc9f9d9e08f6d4","node_id":"C_kwDOS8q7HtoAKDAxYWViOGUyNDQ5YThmNDI1NDkwYjVkNDQ5ZGM5ZjlkOWUwOGY2ZDQ","commit":{"author":{"name":"Shreya Shankar","email":"shreyashankar@shreya-mm.local","date":"2026-06-16T20:21:42Z"},"committer":{"name":"Shreya Shankar","email":"shreyashankar@shreya-mm.local","date":"2026-06-16T20:21:42Z"},"message":"Make the add workflow find sources from the web\n\nThe workflow now searches the web for reputable writing guides not already in\nthe corpus, in addition to reading the local queue, so the corpus grows without\nnew sources being supplied by hand. It caps web sources per run via\nMAX_WEB_SOURCES and only mines rules actually present on a fetched page. Update\nthe README to match.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","tree":{"sha":"7645ed7baa631f4f1c0e0f46380bdc0895e26ed0","url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/git/trees/7645ed7baa631f4f1c0e0f46380bdc0895e26ed0"},"url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/git/commits/01aeb8e2449a8f425490b5d449dc9f9d9e08f6d4","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/01aeb8e2449a8f425490b5d449dc9f9d9e08f6d4","html_url":"https://github.com/shreyashankar/mine-writing-rules/commit/01aeb8e2449a8f425490b5d449dc9f9d9e08f6d4","comments_url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/01aeb8e2449a8f425490b5d449dc9f9d9e08f6d4/comments","author":null,"committer":null,"parents":[{"sha":"b5c88ed5488b9ea1dc233931b579efe651b39bae","url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/b5c88ed5488b9ea1dc233931b579efe651b39bae","html_url":"https://github.com/shreyashankar/mine-writing-rules/commit/b5c88ed5488b9ea1dc233931b579efe651b39bae"}]},{"sha":"b5c88ed5488b9ea1dc233931b579efe651b39bae","node_id":"C_kwDOS8q7HtoAKGI1Yzg4ZWQ1NDg4YjllYTFkYzIzMzkzMWI1NzllZmU2NTFiMzliYWU","commit":{"author":{"name":"Shreya Shankar","email":"shreyashankar@shreya-mm.local","date":"2026-06-16T20:02:25Z"},"committer":{"name":"Shreya Shankar","email":"shreyashankar@shreya-mm.local","date":"2026-06-16T20:02:25Z"},"message":"Add durable scheduling option for the add step\n\nThe in-session Claude Code schedule is session-only and expires after 7 days.\nAdd scripts/add-from-queue.sh, which runs the workflow headlessly and commits,\nso it can run from crontab and keep working across restarts. Document both ways\nin the README.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","tree":{"sha":"34485288d612c562085662a565c29719ae014680","url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/git/trees/34485288d612c562085662a565c29719ae014680"},"url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/git/commits/b5c88ed5488b9ea1dc233931b579efe651b39bae","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/b5c88ed5488b9ea1dc233931b579efe651b39bae","html_url":"https://github.com/shreyashankar/mine-writing-rules/commit/b5c88ed5488b9ea1dc233931b579efe651b39bae","comments_url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/b5c88ed5488b9ea1dc233931b579efe651b39bae/comments","author":null,"committer":null,"parents":[{"sha":"57bbbdf8f97cc99330963dc2ef29cedcaf626b3f","url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/57bbbdf8f97cc99330963dc2ef29cedcaf626b3f","html_url":"https://github.com/shreyashankar/mine-writing-rules/commit/57bbbdf8f97cc99330963dc2ef29cedcaf626b3f"}]},{"sha":"57bbbdf8f97cc99330963dc2ef29cedcaf626b3f","node_id":"C_kwDOS8q7HtoAKDU3YmJiZGY4Zjk3Y2M5OTMzMDk2M2RjMmVmMjljZWRjYWY2MjZiM2Y","commit":{"author":{"name":"Shreya Shankar","email":"shreyashankar@shreya-mm.local","date":"2026-06-16T20:00:45Z"},"committer":{"name":"Shreya Shankar","email":"shreyashankar@shreya-mm.local","date":"2026-06-16T20:00:45Z"},"message":"Organize project, add README, dashboard build, and incremental add workflow\n\nMined writing-style rules from 63 style guides, clustered into a taxonomy, and\ndeduped into writing-rules.json (814 rules, 15 groups, 68 categories).\n\nThis commit cleans up the layout and makes it reproducible and extensible:\n- Move build intermediates into data/, pipeline scripts into workflows/.\n- Add scripts/build.js to rebuild writing-rules.flat.json and dashboard.html\n  from writing-rules.json, the single source of truth.\n- Add .claude/workflows/add-writing-rules.js to mine new sources from\n  sources/queue/, fit them into the taxonomy, dedupe, and rebuild outputs.\n- Add a README written in plain style.\n\nCo-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>","tree":{"sha":"a16c17318bdead316bd2d8b98f2bcbf0b538634a","url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/git/trees/a16c17318bdead316bd2d8b98f2bcbf0b538634a"},"url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/git/commits/57bbbdf8f97cc99330963dc2ef29cedcaf626b3f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/57bbbdf8f97cc99330963dc2ef29cedcaf626b3f","html_url":"https://github.com/shreyashankar/mine-writing-rules/commit/57bbbdf8f97cc99330963dc2ef29cedcaf626b3f","comments_url":"https://api.github.com/repos/shreyashankar/mine-writing-rules/commits/57bbbdf8f97cc99330963dc2ef29cedcaf626b3f/comments","author":null,"committer":null,"parents":[]}]